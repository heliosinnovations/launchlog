# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Note: GitHub OAuth is configured in the Supabase Dashboard under Authentication > Providers
# No additional GitHub OAuth env vars needed - Supabase handles it internally

# Storage Configuration
# Screenshots are stored in Supabase Storage bucket: project-screenshots
# Bucket settings: Public read access, authenticated write only
NEXT_PUBLIC_STORAGE_BUCKET_SCREENSHOTS=project-screenshots
